{
  "name": "opencode-sidebar-tui",
  "version": "0.3.3",
  "description": "Live-status sidebar and footer for OpenCode V2: MCP, budget, context, plugins, skills and todos in one ordered panel, plus git status and provider spend in the prompt footer.",
  "author": "opencode-sidebar-tui contributors",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/r00tb3/opencode-sidebar-tui.git"
  },
  "homepage": "https://github.com/r00tb3/opencode-sidebar-tui#readme",
  "bugs": {
    "url": "https://github.com/r00tb3/opencode-sidebar-tui/issues"
  },
  "main": "./dist/server/index.js",
  "types": "./dist/server/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./tui": "./src/tui.tsx"
  },
  "files": [
    "dist",
    "src",
    "index.ts",
    "tui.tsx",
    "README.md",
    "CHANGELOG.md",
    "docs/sidebar.png",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "pack:check": "npm pack --dry-run",
    "bench:pack": "npm pack --dry-run --json",
    "prepublishOnly": "npm run pack:check"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.3",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "opentui",
    "sidebar",
    "status",
    "todo",
    "budget",
    "skills",
    "footer",
    "terminal"
  ]
}
