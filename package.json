{
  "name": "opencode-statusdeck",
  "version": "0.1.0",
  "description": "OpenCode V2 status deck: ordered sidebar panels with live skills, plugins and todos, plus a git/provider budget footer and optional auto-todo.",
  "author": "opencode-statusdeck contributors",
  "type": "module",
  "license": "MIT",
  "main": "./dist/server/index.js",
  "exports": {
    ".": {
      "types": "./dist/server/index.d.ts",
      "import": "./dist/server/index.js"
    },
    "./tui": "./dist/tui.js"
  },
  "files": [
    "dist",
    "index.ts",
    "tui.tsx",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bun run build:tui",
    "build:tui": "bun build src/tui.tsx --target=bun --outfile dist/tui.js --external @opencode/plugin/tui --external solid-js --external @opentui/solid --external @opentui/core",
    "pack:check": "npm pack --dry-run"
  },
  "peerDependencies": {
    "@opencode/plugin": ">=2.1.3",
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "opencode-tui",
    "sidebar",
    "todo",
    "git"
  ]
}
